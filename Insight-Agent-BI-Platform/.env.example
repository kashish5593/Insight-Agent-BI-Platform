# ==============================================================================
# InsightAgent - Environment Configuration
# ==============================================================================

# Google Gemini API Key
# If omitted or invalid, InsightAgent automatically operates in Autonomous Heuristic Fallback mode
# with realistic enterprise analytical responses so the platform never crashes.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend FastAPI Configuration
API_HOST=127.0.0.1
API_PORT=8000

# SQLite Enterprise Data Warehouse Location
DATABASE_PATH=data/warehouse.db
